# Optional build-time environment variables.
#
# Both values are `NEXT_PUBLIC_*`, which means they are inlined into the static
# bundle at build time and are visible to every visitor. Never put a secret in
# this file.
#
# Local use: copy to `.env.local` (gitignored) and fill in.
# CI use: set `GA_MEASUREMENT_ID` and `GOOGLE_SITE_VERIFICATION` as repository
# variables - see .github/workflows/deploy.yml.

# GA4 Measurement ID (G-XXXXXXXXXX), read by components/analytics.tsx.
# Leave unset to omit the gtag.js loader entirely (local and CI builds stay clean).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token, emitted as the
# `google-site-verification` meta tag by app/layout.tsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
